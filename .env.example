# Market Intelligence Platform — environment configuration
# Copy to .env and fill in. All variables use the MIP_ prefix.

# Required. PostgreSQL DSN (psycopg v3 driver).
MIP_DATABASE_URL=postgresql+psycopg://mip:mip@localhost:5432/mip

# FRED API key (required from Phase 3 onward; free at https://fred.stlouisfed.org/docs/api/api_key.html)
MIP_FRED_API_KEY=

# Root of the immutable raw CSV archive.
MIP_RAWDATA_ROOT=./RawData

# First date of historical backfill for price ingestion.
MIP_HISTORY_START_DATE=2010-01-01

# Retry policy for provider calls.
MIP_RETRY_MAX_ATTEMPTS=4
MIP_RETRY_BACKOFF_SECONDS=1.0

# Log output: "console" (dev) or "json" (cron/production).
MIP_LOG_FORMAT=console

# Used only by integration tests: a THROWAWAY database that tests may
# create/drop objects in. Never point this at the real mip database.
# MIP_TEST_DATABASE_URL=postgresql+psycopg://mip:mip@localhost:5432/mip_test

# ---------------------------------------------------------------------------
# OpenAI research-assistant layer (src/mip/research_assistant).
# The deterministic report works without any of these; when the key is absent
# the qualitative layer reports UNAVAILABLE and report generation continues.
# ---------------------------------------------------------------------------

# Required to enable qualitative research. NEVER commit a real value.
# Read from the environment only; never logged, never written to any artifact.
OPENAI_API_KEY=

# Responses-API model. Default is gpt-5.6-terra (see docs/RESEARCH_ASSISTANT.md).
OPENAI_MODEL=gpt-5.6-terra

# Master switch. "false" disables every OpenAI call regardless of the key.
MIP_OPENAI_ENABLED=true

# Cost controls.
MIP_OPENAI_MAX_SEARCH_CALLS=8
MIP_OPENAI_RESEARCH_FRESHNESS_HOURS=18
MIP_OPENAI_TIMEOUT_SECONDS=300
MIP_OPENAI_MAX_OUTPUT_TOKENS=16000

# Where research artifacts and thesis history are persisted (gitignored).
MIP_RESEARCH_ROOT=data/investment_research

# ---------------------------------------------------------------------------
# Historical survivorship-clean data provider (src/mip/providers/historical).
# NOT configured today: the calibration readiness gate fails and ingestion is
# blocked. See docs/data/SHARADAR_INGESTION_PLAN.md.
# ---------------------------------------------------------------------------

# Required to enable historical ingestion. NEVER commit a real value.
SHARADAR_API_KEY=

# Which provider adapter to use. Vendor-neutral by design.
MIP_HISTORICAL_PROVIDER=sharadar

# Override only if the vendor changes its API host.
SHARADAR_BASE_URL=https://data.nasdaq.com/api/v3
