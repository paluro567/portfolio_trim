# Generated personal decision reports — never commit.
data/reports/
data/validation/

# Generated product decision reports (`mip product report|portfolio`). Kept on
# disk for research and frozen historical review; not tracked.
# The 2026-07-16 AMZN cohort is deliberately re-included: five tests read it as
# a committed fixture (tests/unit/test_product_slice.py REPORT/INPUTS and
# tests/unit/test_product_policy.py::test_policy_provenance_reaches_the_report_bundle).
# The trailing `/*` matters - excluding the directory itself would make the
# negation below unreachable, because git does not descend into an excluded dir.
data/product_reports/*
!data/product_reports/2026-07-16/

# Build artifacts and regenerable ingestion cache (V6 closure)
__pycache__/
*.pyc
RawData/

# Secrets — real environment values. `.env.example` (placeholders only) IS tracked.
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
secrets.yml

# Generated live research artifacts (`mip product research`). Contain third-party
# article titles/URLs and model output; regenerable and not part of the source tree.
data/investment_research/
